            },
            options: { responsive: true, plugins: { legend: { position: 'top' } } }
        });
    }

    function renderGoogleRede() {
        new Chart(document.getElementById('chartGoogleRede'), {
            type: 'bar',
            data: {
                labels: googleData.redes.map(r => r.nome),
                datasets: [
                    { label: 'Gasto (R$)', data: googleData.redes.map(r => r.custo), backgroundColor: '#ffb74d' },
                    { label: 'Conversões', data: googleData.redes.map(r => r.conv), backgroundColor: '#4fc3f7' }
