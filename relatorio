    function renderGoogleDispositivo() {
        const disp = googleData.dispositivos.filter(d => d.custo > 0);
        new Chart(document.getElementById('chartGoogleDispositivo'), {
            type: 'bar',
            data: {
                labels: disp.map(d => d.nome),
                datasets: [
                    { label: 'Gasto (R$)', data: disp.map(d => d.custo), backgroundColor: '#ffb74d' },
                    { label: 'Conversões', data: disp.map(d => d.conv), backgroundColor: '#4fc3f7' }
                ]
            },
            options: { responsive: true, plugins: { legend: { position: 'top' } } }
        });
    }

    function renderGoogleKeywords() {
        const tbody = document.getElementById('googleKeywords');
        tbody.innerHTML = googleData.keywords.map(k => `
            <tr><td><strong>${k.palavra}</strong></td><td>${k.tipo}</td><td>R$ ${fmt(k.custo)}</td><td>${k.cliques}</td><td>${k.ctr.toFixed(2)}%</td></tr>
        `).join('');
    }

    // ================================================================
    // 6. INICIALIZAÇÃO
    // ================================================================
    document.addEventListener('DOMContentLoaded', function() {
        renderResumo();
        renderMetaCards();
        renderGoogleCards();
        renderMetaComparativo();
        renderMetaPlataforma();
        renderMetaSetorIdade();
        renderMetaTabela();
        renderMetaInsight();
        renderGoogleComparativo();
        renderGoogleRede();
        renderGoogleDispositivo();
        renderGoogleKeywords();
    });
</script>
