                label: 'CPA Google',
                val: fmtCurrency(googleData.custoConv),
                comp: fmtCurrency(googleData.custoConv2025),
                pct: pctCpa,
                suffix: 'vs jun/25',
                invert: true,
                tooltip: `Em jun/26 o CPA foi de <strong>${fmtCurrency(googleData.custoConv)}</strong>, uma <strong>${pctCpa < 0 ? 'redução' : 'alta'}</strong> de <strong>${Math.abs(pctCpa).toFixed(1)}%</strong> em relação a jun/25 (R$ ${fmt(googleData.custoConv2025)}).<br><br>` +
                    `<span class="${pctCpa < -3 ? 'good' : pctCpa > 3 ? 'bad' : 'neutral'}">📌 Interpretação:</span> CPA estável ou em queda é um ótimo sinal. Aumentos acima de 3% merecem atenção.`
            },
            {
                label: 'Cliques Google',
                val: fmtInt(googleData.cliques),
                comp: fmtInt(googleData.cliques2025),
                pct: pctCliques,
                suffix: 'vs jun/25',
                tooltip: `Em jun/26 recebemos <strong>${fmtInt(googleData.cliques)}</strong> cliques, um <strong>${pctCliques > 0 ? 'crescimento' : 'queda'}</strong> de <strong>${Math.abs(pctCliques).toFixed(1)}%</strong> em relação a jun/25 (${fmtInt(googleData.cliques2025)}).<br><br>` +
                    `<span class="${pctCliques > 5 ? 'good' : pctCliques < -5 ? 'bad' : 'neutral'}">📌 Interpretação:</span> Cliques são o primeiro passo para conversões. Uma queda pode ser compensada por melhor qualidade do tráfego (maior taxa de conversão).`
            }
        ];
        const container = document.getElementById('googleCards');
        container.innerHTML = cards.map(c => {
            let cls = 'neutral', arrow = '→';
            if (c.pct !== undefined) {
                if (c.pct > 3) { cls = 'up'; arrow = '▲'; } else if (c.pct < -3) { cls = 'down'; arrow = '▼'; }
                if (c.invert) { if (cls === 'up') cls = 'down'; else if (cls === 'down') cls = 'up'; }
            }
            const pctAbs = c.pct !== undefined ? Math.abs(c.pct) : 0;
            const compHtml = c.pct !== undefined ? `<div class="comparison"><span class="${cls}">${arrow} ${pctAbs.toFixed(1)}%</span> <span>${c.suffix}</span></div>` : '';
            return `<div class="card"><div class="label">${c.label}<span class="info-icon">ⓘ<span class="tooltip-text">${c.tooltip}</span></span></div><div class="value">${c.val}</div>${compHtml}</div>`;
        }).join('');
    }

    // ===== Gráficos Meta =====
    function renderMetaComparativo() {
        new Chart(document.getElementById('chartMetaComparativo'), {
            type: 'bar',
            data: {
                labels: ['Gasto (R$)', 'Mensagens', 'CPA (R$)'],
                datasets: [
                    { label: 'Jun/2025', data: [meta2025.spent, meta2025.messaging, meta2025.cpa], backgroundColor: '#90a4ae' },
                    { label: 'Jun/2026', data: [totalMetaSpent, totalMetaMsg, metaCPA], backgroundColor: '#42a5f5' }
                ]
            },
            options: { responsive: true, plugins: { legend: { position: 'top' } } }
        });
    }

    function renderMetaPlataforma() {
        const counts = {};
        metaAnuncios.forEach(a => {
            const plat = a.platform.split('/')[0];
            counts[plat] = (counts[plat] || 0) + a.messaging;
        });
        new Chart(document.getElementById('chartMetaPlataforma'), {
            type: 'pie',
            data: { labels: Object.keys(counts), datasets: [{ data: Object.values(counts), backgroundColor: ['#3b82f6','#8b5cf6','#10b981','#f59e0b'] }] },
            options: { responsive: true, plugins: { legend: { position: 'right' } } }
        });
    }

    function renderMetaSetorIdade() {
        const data = {};
        metaAnuncios.forEach(a => {
            a.ageGender.forEach(ag => {
                const key = a.setor;
                if (!data[key]) data[key] = {};
                data[key][ag.age] = (data[key][ag.age] || 0) + ag.messaging;
            });
        });
        const setores = Object.keys(data);
        const idades = ['18-24', '25-34', '35-44', '45-54', '55-64', '65+'];
        const datasets = idades.map(age => ({
            label: age,
            data: setores.map(s => data[s][age] || 0),
            backgroundColor: ['#1d4ed8','#c2185b','#00838f','#e65100','#7b1fa2','#b71c1c'][idades.indexOf(age)]
        }));
        new Chart(document.getElementById('chartMetaSetorIdade'), {
            type: 'bar',
            data: { labels: setores, datasets: datasets },
            options: { responsive: true, plugins: { legend: { position: 'top' } }, scales: { x: { stacked: true }, y: { stacked: true } } }
        });
    }

    // ===== Tabela Meta =====
    function renderMetaTabela() {
        const tbody = document.getElementById('metaTabela');
        const badgeSetor = {
            'Masculino': 'badge-setor-masculino',
            'Feminino': 'badge-setor-feminino',
            'Infantil': 'badge-setor-infantil',
            'Cama e Banho': 'badge-setor-cama',
            'Institucional': 'badge-setor-institucional'
        };
        tbody.innerHTML = metaAnuncios.map(a => {
            const cpa = a.messaging > 0 ? (a.spent / a.messaging) : 0;
            return `<tr>
                <td><strong>${a.name}</strong></td>
                <td><span class="badge ${badgeSetor[a.setor] || ''}">${a.setor}</span></td>
                <td>${a.tags.map(t => `<span class="badge badge-tag">${t}</span>`).join(' ')}</td>
                <td>R$ ${fmt(a.spent)}</td>
                <td>${a.messaging}</td>
                <td>${a.messaging > 0 ? 'R$ '+fmt(cpa) : '-'}</td>
                <td>${fmtInt(a.reach)}</td>
                <td>${a.frequency ? a.frequency.toFixed(2) : '-'}</td>
                <td>${a.ctr ? a.ctr.toFixed(2)+'%' : '-'}</td>
                <td>${a.platform}</td>
            </tr>`;
        }).join('');
    }

    // ===== Insight Box Meta =====
    function renderMetaInsight() {
        const combinacoes = {};
        metaAnuncios.forEach(a => {
            a.ageGender.forEach(ag => {
                const key = `${a.setor} - ${ag.age} - ${ag.gender}`;
                if (!combinacoes[key]) combinacoes[key] = 0;
                combinacoes[key] += ag.messaging;
            });
        });
        const sorted = Object.entries(combinacoes).sort((a,b) => b[1] - a[1]);
        const top = sorted.slice(0, 3);
        let html = `<strong>📊 Insights por idade/gênero:</strong><br>`;
        top.forEach(([key, val]) => {
            html += `🔹 ${key}: ${val} mensagens<br>`;
        });
        html += `<br><strong>💡 Ação recomendada:</strong> `;
        if (top.length > 0) {
            const first = top[0][0].split(' - ');
            html += `Priorize anúncios do setor <strong>${first[0]}</strong> para o público <strong>${first[1]} (${first[2]})</strong>, pois é o segmento com maior engajamento.`;
        } else {
            html += 'Nenhum dado disponível.';
        }
        document.getElementById('metaInsightBox').innerHTML = html;
    }

