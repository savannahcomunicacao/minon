    const totalMetaSpent = metaAnuncios.reduce((s, i) => s + i.spent, 0);
    const totalMetaMsg = metaAnuncios.reduce((s, i) => s + i.messaging, 0);
    const totalMetaReach = metaAnuncios.reduce((s, i) => s + i.reach, 0);
    const metaCPA = totalMetaMsg > 0 ? totalMetaSpent / totalMetaMsg : 0;
    const metaCTR = metaAnuncios.reduce((s, i) => s + (i.ctr || 0), 0) / metaAnuncios.filter(a => a.ctr).length;
    const metaFreq = metaAnuncios.reduce((s, i) => s + (i.frequency || 0), 0) / metaAnuncios.filter(a => a.frequency).length;

    // Dados 2025
    const meta2025 = { spent: 969.67, messaging: 113, cpa: 8.58 };

    // ================================================================
    // 4. DADOS GOOGLE ADS
    // ================================================================
    const googleData = {
        gasto: 487.95,
        conversoes: 149,
        custoConv: 3.27,
        cliques: 733,
        gasto2025: 605.74,
        conversoes2025: 188,
        custoConv2025: 3.22,
        cliques2025: 964,
        redes: [
            { nome: 'Pesquisa Google', cliques: 455, custo: 366.74, conv: 149 },
            { nome: 'Parceiros de pesquisa', cliques: 9, custo: 2.60, conv: 0 },
            { nome: 'Rede de Display', cliques: 269, custo: 118.61, conv: 0 }
        ],
        dispositivos: [
            { nome: 'Computadores', custo: 24.44, cliques: 34, conv: 8 },
            { nome: 'Smartphones', custo: 463.14, cliques: 698, conv: 141 },
            { nome: 'Tablets', custo: 0.37, cliques: 1, conv: 0 }
        ],
        keywords: [
            { palavra: 'minon', tipo: 'Correspondência ampla', custo: 133.49, cliques: 156, ctr: 28.36 },
            { palavra: 'loja minon', tipo: 'Correspondência ampla', custo: 53.22, cliques: 73, ctr: 35.61 },
            { palavra: 'loja de roupas infantil', tipo: 'Correspondência ampla', custo: 31.20, cliques: 43, ctr: 9.49 },
            { palavra: 'lojas de roupas femininas', tipo: 'Correspondência ampla', custo: 26.91, cliques: 41, ctr: 10.43 },
            { palavra: 'roupa de bebe', tipo: 'Correspondência ampla', custo: 20.15, cliques: 19, ctr: 8.52 }
        ]
    };

    // ================================================================
    // 5. RENDERIZAÇÃO
    // ================================================================
    // Resumo geral
    function renderResumo() {
        document.getElementById('resumoMetaGasto').innerHTML = fmtCurrency(totalMetaSpent);
        document.getElementById('resumoMetaMsg').innerHTML = fmtInt(totalMetaMsg);
        document.getElementById('resumoMetaCPA').innerHTML = fmtCurrency(metaCPA);
        document.getElementById('resumoMetaCTR').innerHTML = metaCTR.toFixed(2);
        document.getElementById('resumoMetaFreq').innerHTML = metaFreq.toFixed(2);

        document.getElementById('resumoGoogleGasto').innerHTML = fmtCurrency(googleData.gasto);
        document.getElementById('resumoGoogleConv').innerHTML = fmtInt(googleData.conversoes);
        document.getElementById('resumoGoogleCPA').innerHTML = fmtCurrency(googleData.custoConv);
        document.getElementById('resumoGoogleCliques').innerHTML = fmtInt(googleData.cliques);

        const bonsMeta = metaAnuncios.filter(a => a.messaging > 5 && (a.spent/a.messaging) < metaCPA * 0.8);
        document.getElementById('resumoDestaquesMeta').innerHTML = bonsMeta.map(a => a.name).join('; ') || 'Nenhum destaque específico.';

        const topKeywords = googleData.keywords.sort((a,b) => b.ctr - a.ctr).slice(0,2);
        document.getElementById('resumoDestaquesGoogle').innerHTML = topKeywords.map(k => `${k.palavra} (CTR ${k.ctr.toFixed(2)}%)`).join('; ') || '-';

        const ruinsMeta = metaAnuncios.filter(a => a.messaging > 5 && (a.spent/a.messaging) > metaCPA * 1.3);
        document.getElementById('resumoOportunidades').innerHTML = ruinsMeta.map(a => a.name).join('; ') || 'Nenhum anúncio com CPA acima da média.';

        let insights = [];
        const setorIdade = {};
        metaAnuncios.forEach(a => {
            a.ageGender.forEach(ag => {
                const key = `${a.setor}-${ag.age}-${ag.gender}`;
                if (!setorIdade[key]) setorIdade[key] = 0;
                setorIdade[key] += ag.messaging;
            });
        });
        const sorted = Object.entries(setorIdade).sort((a,b) => b[1] - a[1]).slice(0,3);
        insights = sorted.map(([key, val]) => {
            const parts = key.split('-');
            return `${parts[0]} (${parts[1]}, ${parts[2]}) gerou ${val} mensagens`;
        });
        document.getElementById('resumoInsights').innerHTML = insights.join('; ') || 'Nenhum dado de idade/gênero disponível.';

        const sugestoes = [];
        const femInsta = metaAnuncios.filter(a => a.setor === 'Feminino' && a.platform.includes('Instagram'));
        if (femInsta.length > 0) {
            sugestoes.push('Priorizar criativos femininos no Instagram, especialmente para faixa 25-34 anos (maior volume).');
        }
        const masc = metaAnuncios.filter(a => a.setor === 'Masculino');
        if (masc.some(a => a.messaging > 10)) {
            sugestoes.push('Manter investimento em masculino, mas testar novos ângulos criativos para melhorar CTR.');
        }
        const infantil = metaAnuncios.filter(a => a.setor === 'Infantil');
        if (infantil.some(a => a.messaging > 20)) {
            sugestoes.push('O setor Infantil tem potencial – explore vídeos e carrosséis para aumentar engajamento.');
        }
        document.getElementById('resumoSugestoes').innerHTML = sugestoes.join(' ') || 'Analise os dados para definir próximos passos.';
    }

    // ===== Meta Cards (com tooltips e comparação) =====
    function renderMetaCards() {
        const pctGasto = pct(meta2025.spent, totalMetaSpent);
        const pctMsg = pct(meta2025.messaging, totalMetaMsg);
        const pctCpa = -pct(meta2025.cpa, metaCPA);
        const cards = [
            {
                label: 'Gasto Meta',
                val: fmtCurrency(totalMetaSpent),
                comp: fmtCurrency(meta2025.spent),
                pct: pctGasto,
                suffix: 'vs jun/25',
                tooltip: `Em jun/26 gastamos <strong>${fmtCurrency(totalMetaSpent)}</strong>, um <strong>${pctGasto > 0 ? 'aumento' : 'redução'}</strong> de <strong>${Math.abs(pctGasto).toFixed(1)}%</strong> em relação a jun/25 (R$ ${fmt(meta2025.spent)}).<br><br>` +
                    `<span class="${pctGasto > 5 ? 'good' : 'neutral'}">📌 Interpretação:</span> O aumento no investimento foi planejado para testar novos públicos e criativos. Como as mensagens cresceram ${pctMsg.toFixed(1)}%, o retorno está sendo positivo.`
            },
            {
                label: 'Mensagens Meta',
                val: fmtInt(totalMetaMsg),
                comp: fmtInt(meta2025.messaging),
                pct: pctMsg,
                suffix: 'vs jun/25',
                tooltip: `Em jun/26 geramos <strong>${fmtInt(totalMetaMsg)}</strong> mensagens, um <strong>${pctMsg > 0 ? 'crescimento' : 'queda'}</strong> de <strong>${Math.abs(pctMsg).toFixed(1)}%</strong> em relação a jun/25 (${fmtInt(meta2025.messaging)}).<br><br>` +
                    `<span class="${pctMsg > 10 ? 'good' : pctMsg < -5 ? 'bad' : 'neutral'}">📌 Interpretação:</span> O volume de mensagens é o principal indicador de engajamento. Um crescimento acima de 10% é considerado excelente.`
            },
            {
                label: 'CPA Meta',
                val: fmtCurrency(metaCPA),
                comp: fmtCurrency(meta2025.cpa),
                pct: pctCpa,
                suffix: 'vs jun/25',
                invert: true,
                tooltip: `Em jun/26 o CPA foi de <strong>${fmtCurrency(metaCPA)}</strong>, uma <strong>${pctCpa < 0 ? 'redução' : 'alta'}</strong> de <strong>${Math.abs(pctCpa).toFixed(1)}%</strong> em relação a jun/25 (R$ ${fmt(meta2025.cpa)}).<br><br>` +
                    `<span class="${pctCpa < -5 ? 'good' : pctCpa > 5 ? 'bad' : 'neutral'}">📌 Interpretação:</span> Quanto menor o CPA, melhor. Reduções acima de 5% indicam maior eficiência da campanha.`
            },
            {
                label: 'CTR Meta',
                val: metaCTR.toFixed(2) + '%',
                tooltip: `A taxa de cliques (CTR) média foi de <strong>${metaCTR.toFixed(2)}%</strong>.<br><br>` +
                    `<span class="${metaCTR > 3 ? 'good' : metaCTR < 1.5 ? 'bad' : 'neutral'}">📌 Interpretação:</span> CTR acima de 3% é considerado bom para Meta Ads. Abaixo de 1,5% sugere que os criativos ou a segmentação precisam ser revisados.`
            }
        ];
        const container = document.getElementById('metaCards');
        container.innerHTML = cards.map(c => {
            let cls = 'neutral', arrow = '→';
            if (c.pct !== undefined) {
                if (c.pct > 3) { cls = 'up'; arrow = '▲'; } else if (c.pct < -3) { cls = 'down'; arrow = '▼'; }
                if (c.invert) { if (cls === 'up') cls = 'down'; else if (cls === 'down') cls = 'up'; }
            }
            const pctAbs = c.pct !== undefined ? Math.abs(c.pct) : 0;
            const compHtml = c.pct !== undefined ? `<div class="comparison"><span class="${cls}">${arrow} ${pctAbs.toFixed(1)}%</span> <span>${c.suffix}</span></div>` : '';
            return `<div class="card"><div class="label">${c.label}<span class="info-icon">ⓘ<span class="tooltip-text">${c.tooltip}</span></span></div><div class="value">${c.val}</div>${compHtml}</div>`;
        }).join('');
    }

    // ===== Google Cards (com tooltips e comparação) =====
    function renderGoogleCards() {
        const pctGasto = pct(googleData.gasto2025, googleData.gasto);
        const pctConv = pct(googleData.conversoes2025, googleData.conversoes);
        const pctCpa = -pct(googleData.custoConv2025, googleData.custoConv);
        const pctCliques = pct(googleData.cliques2025, googleData.cliques);
        const cards = [
            {
                label: 'Gasto Google',
                val: fmtCurrency(googleData.gasto),
                comp: fmtCurrency(googleData.gasto2025),
                pct: pctGasto,
                suffix: 'vs jun/25',
                tooltip: `Em jun/26 gastamos <strong>${fmtCurrency(googleData.gasto)}</strong>, um <strong>${pctGasto > 0 ? 'aumento' : 'redução'}</strong> de <strong>${Math.abs(pctGasto).toFixed(1)}%</strong> em relação a jun/25 (R$ ${fmt(googleData.gasto2025)}).<br><br>` +
                    `<span class="${pctGasto < -5 ? 'good' : pctGasto > 5 ? 'bad' : 'neutral'}">📌 Interpretação:</span> Redução no gasto com manutenção ou aumento das conversões é um sinal de eficiência.`
