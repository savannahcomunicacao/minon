    function renderGoogleComparativo() {
        new Chart(document.getElementById('chartGoogleComparativo'), {
            type: 'bar',
            data: {
                labels: ['Gasto (R$)', 'Conversões', 'Cliques', 'CPA (R$)'],
                datasets: [
